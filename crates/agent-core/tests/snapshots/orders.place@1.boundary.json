  "verification": [
    {
      "method": "order-exists",
      "strength": "establishes"
    },
    {
      "method": "placed-event",
      "strength": "corroborates"
    }
  ],
  "handover": [
    {
      "id": "distinct-provider",
      "rule": "the replacement is a different provider, under its own id",
      "rejection": "same-provider"
    },
    {
      "id": "source-active",
      "rule": "the source provider is ACTIVE and is the exact expected registration",
      "rejection": "from-not-active"
    },
    {
      "id": "target-registered",
      "rule": "the replacement is REGISTERED (not promoted) and is the exact expected registration",
      "rejection": "to-not-registered"
    },
    {
      "id": "provides-capability",
      "rule": "the replacement provides the capability version",
      "rejection": "capability-not-provided"
    },
    {
      "id": "contract-match",
      "rule": "the replacement's contract for the capability matches the source's",
      "rejection": "contract-mismatch"
    },
    {
      "id": "validated",
      "rule": "the replacement's pending revision has a passing validation for its exact fingerprint",
      "rejection": "to-not-validated"
    },
    {
      "id": "promotion-checks",
      "rule": "the gateway's promotion checks pass for the replacement now",
      "rejection": "promotion-checks-failed"
    },
    {
      "id": "consumer-grants",
      "rule": "every consumer granted the capability from the source holds its own current grant for the replacement; no grant is copied",
      "rejection": "replacement-not-authorized"
    }
  ]
