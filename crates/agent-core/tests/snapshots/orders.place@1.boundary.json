    },
    {
      "node": "capability:com.example.orders/orders.byref@1",
      "relationship": "checked-by",
      "via": "no-duplicate"
    },
    {
      "node": "capability:com.example.orders/orders.get@1",
      "relationship": "observes",
      "required": false,
      "via": "lookup"
    },
    {
      "node": "capability:com.example.orders/orders.get@1",
      "relationship": "verified-by",
      "via": "order-exists"
    },
    {
      "node": "event:com.example.orders/orders.placed",
      "relationship": "emits"
    },
    {
      "node": "event:com.example.pricing/pricing.changed",
      "relationship": "consumes-event",
