  "constraints": [
    {
      "code": "identity",
      "rule": "serve orders.place@1 under the same name and version"
    },
    {
      "code": "kind",
      "rule": "remain a request capability"
    },
    {
      "code": "input.accept-no-less",
      "rule": "accept every input the current input schema accepts: add no required field, remove no field, change no field type, narrow no enum, bound or pattern"
    },
    {
      "code": "output.return-no-more",
      "rule": "return only what the current output schema allows: remove no field consumers receive, change no field type, widen no enum or bound"
    },
    {
      "code": "semantics.identifiers",
      "rule": "keep every x-appport-* annotation on existing fields unchanged; new annotations are allowed"
    },
    {
      "code": "effect",
      "rule": "keep the declared effect `consequential`"
    },
    {
      "code": "idempotency",
      "rule": "keep idempotency `supported`"
    },
    {
      "code": "authorization.no-tightening",
      "rule": "require no permission beyond orders.write"
    },
    {
      "code": "events",
      "rule": "keep emitting orders.placed"
    },
    {
      "code": "integration.authority",
      "rule": "keep the authority `https://schema.example.com/authority/orders`"
    },
    {
      "code": "integration.effects",
      "rule": "keep the declared effect types https://schema.example.com/effects/order-created, https://schema.example.com/effects/stock-reserved"
    }
  ],
  "dependents": [],
  "reaches": [
    {
      "node": "capability:com.example.inventory/inventory.reserve@1",
