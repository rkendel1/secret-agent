        "orders.cancel@1": {
          "authority": "https://schema.example.com/authority/orders",
          "effects": [
            {
              "type": "https://schema.example.com/effects/order-cancelled"
            }
          ],
          "verify": [
            {
              "id": "order-cancelled",
              "kind": "state",
              "via": {
                "capability": "orders.get",
                "version": 1,
                "input": {
                  "orderId": {
                    "$input": "/orderId"
                  }
                }
              },
              "expect": [
                {
                  "at": "/status",
                  "equals": "cancelled"
                }
              ]
            }
          ],
          "requires": [
            {
              "id": "read-back",
              "relationship": "observes",
              "target": {
                "capability": "orders.get"
              },
              "versionConstraint": ">=1",
              "required": true
            }
          ],
          "access": [
            {
              "resource": "urn:example:orders:order",
              "mode": "changes",
              "operations": [
                "update"
              ]
            }
          ],
          "approval": {
            "required": false
          },
          "preconditions": [
            {
              "id": "exists",
              "via": {
                "capability": "orders.get",
                "version": 1,
                "input": {
                  "orderId": {
                    "$input": "/orderId"
                  }
                }
              },
              "require": "found",
              "expect": [
                {
                  "at": "/status",
                  "equals": "placed"
                }
              ]
            }
          ],
          "failures": [
            {
              "code": "NOT_FOUND",
              "retry": "safe",
              "effect": "none"
            }
          ]
        },
        "orders.get@1": {
          "purpose": "Look up the current state of an order.",
          "authority": "https://schema.example.com/authority/orders",
          "access": [
            {
              "resource": "urn:example:orders:order",
              "mode": "reads"
            }
          ],
          "coverage": {
            "requires": "complete",
            "access": "complete"
          }
        },
        "orders.place@1": {
          "purpose": "Create a customer order and reserve stock.",
          "authority": "https://schema.example.com/authority/orders",
          "effects": [
            {
              "type": "https://schema.example.com/effects/order-created",
