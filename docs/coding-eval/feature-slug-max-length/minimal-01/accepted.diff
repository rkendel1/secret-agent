 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - if given, the slug is at most this many characters long.
+ *               It is cut at a word boundary when possible and never ends
+ *               with a hyphen. A single first word longer than maxLength
+ *               is cut hard, since no word boundary is available.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const { maxLength } = options || {};
+  if (maxLength == null || slug.length <= maxLength) {
+    return slug;
+  }
+
+  const limit = Math.floor(maxLength);
+  if (!(limit > 0)) {
+    return "";
+  }
+
+  // Look one character past the limit: if that character is a hyphen,
+  // the word ending exactly at the limit is complete and can be kept.
+  const window = slug.slice(0, limit + 1);
+  const lastHyphen = window.lastIndexOf("-");
+  if (lastHyphen > 0) {
+    return slug.slice(0, lastHyphen);
+  }
+
+  // No word boundary within the limit: the first word is too long, cut it.
+  return slug.slice(0, limit).replace(/-+$/, "");
 }
