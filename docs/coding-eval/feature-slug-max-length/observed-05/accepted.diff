 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - the slug is at most this many characters long. It never ends
+ *               with a hyphen, and it is cut at a word boundary when possible.
+ *               A single word longer than maxLength is cut mid-word.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const maxLength = options && options.maxLength;
+  if (maxLength === undefined || maxLength === null || slug.length <= maxLength) {
+    return slug;
+  }
+  if (!(maxLength > 0)) {
+    return "";
+  }
+
+  let cut = slug.slice(0, maxLength);
+  if (slug[maxLength] !== "-") {
+    // The cut falls inside a word; back up to the previous word boundary.
+    const boundary = cut.lastIndexOf("-");
+    if (boundary > 0) {
+      cut = cut.slice(0, boundary);
+    }
+  }
+  return cut.replace(/-+$/g, "");
 }
