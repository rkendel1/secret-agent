 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - if given, the slug is at most this many characters long.
+ *               It never ends with a hyphen, and it is shortened at a word
+ *               boundary when possible. A word is cut only when the first
+ *               word alone is longer than maxLength.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const maxLength = options == null ? undefined : options.maxLength;
+  if (maxLength === undefined || maxLength === null) return slug;
+
+  const limit = Math.max(0, Math.floor(Number(maxLength)));
+  if (Number.isNaN(limit)) return slug;
+  if (slug.length <= limit) return slug;
+  if (limit === 0) return "";
+
+  let cut = slug.slice(0, limit);
+
+  // If the next character is not a hyphen, the cut falls inside a word.
+  if (slug[limit] !== "-") {
+    const lastHyphen = cut.lastIndexOf("-");
+    if (lastHyphen > 0) {
+      cut = cut.slice(0, lastHyphen);
+    }
+    // Otherwise the first word alone is too long; cutting it is unavoidable.
+  }
+
+  return cut.replace(/-+$/g, "");
 }
