 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - if given, the slug is at most this many characters long. It is
+ *               shortened at a word boundary when possible (a single word longer
+ *               than maxLength is cut), and never ends with a hyphen.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const { maxLength } = options ?? {};
+  if (typeof maxLength !== "number" || !(maxLength >= 0) || slug.length <= maxLength) {
+    return slug;
+  }
+
+  const limit = Math.floor(maxLength);
+  let cut = slug.slice(0, limit);
+  if (slug[limit] !== "-") {
+    // The cut falls inside a word; back up to the last word boundary if any.
+    const lastHyphen = cut.lastIndexOf("-");
+    if (lastHyphen > 0) {
+      cut = cut.slice(0, lastHyphen);
+    }
+  }
+  return cut.replace(/-+$/g, "");
 }
