 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - the slug is at most this many characters long. It never ends
+ *               with a hyphen. It is cut at a word boundary when one exists
+ *               within the limit. A single word longer than the limit is cut
+ *               hard.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const maxLength = options == null ? undefined : options.maxLength;
+  if (maxLength === undefined || maxLength === null) return slug;
+
+  const limit = Math.floor(Number(maxLength));
+  if (Number.isNaN(limit)) return slug;
+  if (limit <= 0) return "";
+  if (slug.length <= limit) return slug;
+
+  // The cut lands exactly on a word boundary.
+  if (slug[limit] === "-") {
+    return slug.slice(0, limit).replace(/-+$/, "");
+  }
+
+  const head = slug.slice(0, limit);
+  const lastHyphen = head.lastIndexOf("-");
+  if (lastHyphen > 0) {
+    return head.slice(0, lastHyphen).replace(/-+$/, "");
+  }
+
+  // A single word is longer than the limit, so it has to be cut.
+  return head.replace(/-+$/, "");
 }
