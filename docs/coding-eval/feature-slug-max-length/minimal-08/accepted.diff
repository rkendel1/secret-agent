 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - if given, the slug is at most this many characters long. It is
+ *               cut at a word boundary whenever possible. If the first word alone
+ *               is longer than maxLength, that word is cut. The result never ends
+ *               with a hyphen.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const maxLength = options == null ? undefined : options.maxLength;
+  if (maxLength === undefined || maxLength === null) return slug;
+  const limit = Math.floor(Number(maxLength));
+  if (Number.isNaN(limit) || limit === Infinity) return slug;
+  if (limit <= 0) return "";
+  if (slug.length <= limit) return slug;
+
+  let cut = slug.slice(0, limit);
+  if (slug[limit] !== "-") {
+    // The cut lands inside a word; back up to the previous word boundary if any.
+    const lastHyphen = cut.lastIndexOf("-");
+    if (lastHyphen > 0) {
+      cut = cut.slice(0, lastHyphen);
+    }
+  }
+  return cut.replace(/-+$/g, "");
 }
