 /**
  * A URL slug: lowercase ASCII letters and digits separated by single hyphens.
  * Accents are dropped ("Café" -> "cafe"); anything else separates words.
+ *
+ * Options:
+ *   maxLength - if given, the slug is at most this many characters long.
+ *               It never ends with a hyphen, and it is cut at a word boundary
+ *               when possible. A single first word that is longer than
+ *               maxLength is cut to fit.
  */
-export function slugify(text) {
-  return text
+export function slugify(text, options = {}) {
+  const slug = text
     .normalize("NFKD")
-    .replace(/[̀-ͯ]/g, "")
+    .replace(/[\u0300-\u036f]/g, "")
     .toLowerCase()
     .replace(/[^a-z0-9]+/g, "-")
     .replace(/^-+|-+$/g, "");
+
+  const maxLength = options == null ? undefined : options.maxLength;
+  if (maxLength === undefined || maxLength === null) {
+    return slug;
+  }
+
+  const limit = Math.floor(Number(maxLength));
+  if (Number.isNaN(limit)) {
+    return slug;
+  }
+  if (limit <= 0) {
+    return "";
+  }
+  if (slug.length <= limit) {
+    return slug;
+  }
+
+  let cut = slug.slice(0, limit);
+  // If the next character is a hyphen, the cut falls exactly on a word boundary.
+  if (slug[limit] !== "-") {
+    const lastHyphen = cut.lastIndexOf("-");
+    if (lastHyphen > 0) {
+      cut = cut.slice(0, lastHyphen);
+    }
+    // Otherwise the first word alone is too long; keep the hard cut.
+  }
+
+  return cut.replace(/-+$/g, "");
 }
